# Copy to `.env` (which is git-ignored) and fill in the real values.
#
# ROUTER_KEY_A / ROUTER_KEY_B are the keys you hand to Codex / API clients.
# REAL_API_KEY_A / REAL_API_KEY_B are the genuine upstream keys and must never
# be given to a client.

ROUTER_KEY_A=replace-me-with-a-router-key-for-route-a
ROUTER_KEY_B=replace-me-with-a-router-key-for-route-b

REAL_API_KEY_A=sk-replace-me-with-the-real-upstream-key-a
REAL_API_KEY_B=sk-replace-me-with-the-real-upstream-key-b
